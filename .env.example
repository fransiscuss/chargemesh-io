# Local Postgres default. Replace with a Neon development branch URL for Neon checks.
DATABASE_URL=postgres://chargemesh:chargemesh@localhost:5432/chargemesh

# Base64 encoding of 32 random bytes (AES-256-GCM); never commit the real key.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENC_KEY=
